# Copy to .env and fill in. NEVER commit .env.
# Any integration left blank runs in MOCK mode (when JML_MODE=auto).

# auto | live | mock
JML_MODE=auto
JML_HTTP_TIMEOUT=15

# --- Okta (free Integrator / Developer org: https://developer.okta.com/signup/) ---
# Admin Console > Security > API > Tokens > Create token
OKTA_ORG_URL=https://dev-00000000.okta.com
OKTA_API_TOKEN=

# --- Google Workspace (14-day trial) -----------------------------------------
# Service account JSON key with domain-wide delegation for scopes:
#   https://www.googleapis.com/auth/admin.directory.user
#   https://www.googleapis.com/auth/admin.directory.user.security
GWS_SERVICE_ACCOUNT_FILE=./service-account.json
# A super-admin the service account impersonates
GWS_ADMIN_SUBJECT=admin@your-domain.com
GWS_CUSTOMER_ID=my_customer

# --- 1Password Business (14-day trial) ---------------------------------------
# SCIM bridge URL + bearer token (Integrations > Directory > SCIM bridge)
OP_SCIM_BRIDGE_URL=https://op-scim.your-domain.com
OP_SCIM_TOKEN=
# Events Reporting API bearer token (Integrations > Events Reporting) - optional
OP_EVENTS_TOKEN=
OP_EVENTS_URL=https://events.1password.com

# --- Jamf Pro (no free tier - leave blank to mock) ---------------------------
JAMF_URL=
JAMF_USERNAME=
JAMF_PASSWORD=
JAMF_INVITATION_EXPIRY_DAYS=14

# --- Alerts (Slack and/or e-mail; falls back to console) ---------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
